# Tekinsof plataforma — every variable the build or the apps read. Copied to .env by the Bootstrap
# block; the local values below make every gate run offline (PGlite, log mailer, local storage,
# Cloudflare's always-pass Turnstile test key). Production values live only in Vercel.

# ── Database (packages/core, both apps) ── required from step 2
DATABASE_URL=pglite://.data/dev
# Production only: Supabase direct connection (port 5432) used by migrations. Leave empty locally.
DATABASE_URL_DIRECT=
# Seed the demo landing (step 18). Never set in production.
SEED_DEMO=1

# ── Auth (apps/crm) ── required from step 4
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
CRM_BOOTSTRAP_ADMIN_EMAIL=gerencia@tekinsof.com
ALLOWED_EMAIL_DOMAIN=tekinsof.com
AUTH_TEST_MODE=0
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── Public lead endpoint (apps/crm) ── from step 8
SITE_ORIGIN=http://localhost:4321
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Mail through Microsoft Graph (apps/crm) ── from step 11
MAIL_DRIVER=log
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SYSTEM_SENDER=notificaciones@tekinsof.com
CRM_BASE_URL=http://localhost:3000

# ── Background jobs (apps/crm) ── from step 11
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Files (apps/crm) ── from step 16
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site regeneration (apps/crm) ── from step 12
VERCEL_DEPLOY_HOOK_URL=

# ── Public site (apps/web, read at build time) ── from step 10
PUBLIC_LEADS_API_URL=http://localhost:3000/api/public/leads
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_WHATSAPP_NUMBER=51981053022
PUBLIC_BOOKINGS_URL=https://outlook.office365.com/book/Reservasparainformacin@tekinsof.com/
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
