---
import Automation from "../components/home/Automation.astro";
import Benefits from "../components/home/Benefits.astro";
import Cases from "../components/home/Cases.astro";
import Contact from "../components/home/Contact.astro";
import FinalCta from "../components/home/FinalCta.astro";
import Hero from "../components/home/Hero.astro";
import Marketing from "../components/home/Marketing.astro";
import Services from "../components/home/Services.astro";
import SocialProof from "../components/home/SocialProof.astro";
import Technologies from "../components/home/Technologies.astro";
import Timeline from "../components/home/Timeline.astro";
import Base from "../layouts/Base.astro";
import { getFeaturedServices, getPublishedServices, whatsappLink } from "../lib/content.ts";

const whatsappHref = whatsappLink("Hola Tekinsof, quiero información (/)");
const [groups, published] = await Promise.all([getFeaturedServices(), getPublishedServices()]);
const services = published.map(({ slug, name }) => ({ slug, name }));
const count = (category: string) => published.filter((s) => s.category === category).length;
const ai = published.find((s) => s.slug === "inteligencia-artificial-para-negocios");

// Only figures Tekinsof can stand behind: catalog sizes from the database and the SLA (blueprint §1).
const stats = [
  { value: count("tecnologia"), label: "servicios de tecnología" },
  { value: count("marketing"), label: "servicios de marketing digital" },
  { value: 4, prefix: "<", suffix: " h", label: "para responder en horario laboral" },
];

const offerCatalog = {
  "@type": "OfferCatalog",
  "@id": "https://tekinsof.com/#servicios",
  name: "Servicios de Tekinsof Consulting",
  provider: { "@id": "https://tekinsof.com/#organization" },
  itemListElement: published.map((s) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: s.name,
      description: s.summary,
      url: `https://tekinsof.com/servicios/${s.slug}`,
    },
  })),
};
---

<Base
  title="Tekinsof Consulting | Tecnología y marketing digital para empresas"
  description="Desarrollo de software, integración ERP/CRM, Power BI, Microsoft 365, automatización con IA y marketing digital para empresas en Perú."
  canonical="https://tekinsof.com/"
  jsonLd={[offerCatalog]}
  overlayHeader
>
  <Hero whatsappHref={whatsappHref} stats={stats} />
  <Services groups={groups} />
  <Timeline />
  <Automation aiHref={ai && `/servicios/${ai.slug}`} />
  <Marketing />
  <Technologies />
  <Cases />
  <Benefits />
  <SocialProof />
  <FinalCta whatsappHref={whatsappHref} />
  <Contact whatsappHref={whatsappHref} services={services} />
</Base>
