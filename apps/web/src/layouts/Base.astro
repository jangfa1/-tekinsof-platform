---
import ContactDock from "../components/layout/ContactDock.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { company, getPublishedServices, whatsappLink } from "../lib/content.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  /** Absolute or root-relative 1200×630 image for Open Graph and Twitter cards. */
  image?: string;
  /** Extra JSON-LD merged into the page graph (e.g. the home page offer catalog). */
  jsonLd?: Record<string, unknown>[];
  /** The page opens with its own ink hero that sits under the floating header. */
  overlayHeader?: boolean;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  image = "/og-default.png",
  jsonLd = [],
  overlayHeader = false,
} = Astro.props;
const services = await getPublishedServices();
const ogImage = new URL(image, "https://tekinsof.com").toString();

// PUBLIC_* values are read at build time; the site is fully static.
const ga4 = process.env.PUBLIC_GA4_ID ?? "";
const metaPixel = process.env.PUBLIC_META_PIXEL_ID ?? "";
const linkedin = process.env.PUBLIC_LINKEDIN_PARTNER_ID ?? "";
const tiktokPixel = process.env.PUBLIC_TIKTOK_PIXEL_ID ?? "";
const hasPixels = Boolean(ga4 || metaPixel || linkedin || tiktokPixel);

const whatsappHref = whatsappLink(`Hola Tekinsof, quiero información (${Astro.url.pathname})`);

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://tekinsof.com/#organization",
      name: "Tekinsof Consulting",
      url: "https://tekinsof.com",
      logo: "https://tekinsof.com/og-default.png",
      image: "https://tekinsof.com/og-default.png",
      email: company.email,
      telephone: company.phoneE164,
      areaServed: { "@type": "Country", name: "Perú" },
      address: {
        "@type": "PostalAddress",
        streetAddress: company.streetAddress,
        addressLocality: company.locality,
        addressRegion: "Lima",
        addressCountry: "PE",
      },
      hasMap: company.mapsUrl,
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "09:00",
        closes: "18:00",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        telephone: company.phoneE164,
        email: company.email,
        url: `https://wa.me/${company.whatsapp}`,
        availableLanguage: "es",
        areaServed: "PE",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://tekinsof.com/#website",
      url: "https://tekinsof.com",
      name: "Tekinsof Consulting",
      inLanguage: "es-PE",
      publisher: { "@id": "https://tekinsof.com/#organization" },
    },
    ...jsonLd,
  ],
};
---

<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Tekinsof Consulting" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#121417" />
    <meta name="geo.region" content="PE-LMA" />
    <meta name="geo.placename" content="Lima" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="min-h-dvh bg-background font-sans text-fg antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[var(--radius-control)] focus:bg-background focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>
    <SiteHeader services={services} />

    <main id="contenido" class:list={[!overlayHeader && "pt-24"]}>
      <slot />
    </main>

    <SiteFooter services={services} />

    <ContactDock whatsappHref={whatsappHref} />
    <script is:inline>
      // Animated counters: the final value is already in the HTML; this only replays it once.
      (function () {
        var els = document.querySelectorAll("[data-count]");
        if (!els.length || !("IntersectionObserver" in window)) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              io.unobserve(entry.target);
              var el = entry.target;
              var end = Number(el.getAttribute("data-count"));
              var start = performance.now();
              function step(now) {
                var p = Math.min((now - start) / 1200, 1);
                el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          },
          { threshold: 0.6 },
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    {
      hasPixels && (
        <div
          id="consent-banner"
          hidden
          role="region"
          aria-label="Consentimiento de cookies"
          class="fixed inset-x-4 bottom-20 z-50 mx-auto max-w-xl rounded-[var(--radius-card)] border border-border bg-background p-4 shadow-[0_10px_30px_rgb(18_20_23/0.18)]"
        >
          <p class="text-sm">
            Usamos cookies de medición para mejorar nuestros anuncios. ¿Nos permites usarlas?{" "}
            <a href="/privacidad" class="text-link">Más información</a>
          </p>
          <div class="mt-3 flex gap-2">
            <button
              type="button"
              id="consent-accept"
              class="min-h-9 rounded-[var(--radius-control)] bg-accent px-4 text-sm font-medium text-accent-fg"
            >
              Aceptar
            </button>
            <button
              type="button"
              id="consent-reject"
              class="min-h-9 rounded-[var(--radius-control)] border border-border px-4 text-sm font-medium"
            >
              Rechazar
            </button>
          </div>
        </div>
      )
    }
    {
      hasPixels && (
        <script is:inline define:vars={{ ga4, metaPixel, linkedin, tiktokPixel }}>
          function addScript(src) {
            var s = document.createElement("script");
            s.async = true;
            s.src = src;
            document.head.appendChild(s);
          }
          function loadPixels() {
            if (ga4) {
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", ga4);
              addScript("https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(ga4));
            }
            if (metaPixel) {
              var f = (window.fbq = function () {
                f.callMethod ? f.callMethod.apply(f, arguments) : f.queue.push(arguments);
              });
              f.push = f; f.loaded = true; f.version = "2.0"; f.queue = [];
              window._fbq = f;
              addScript("https://connect.facebook.net/en_US/fbevents.js");
              window.fbq("init", metaPixel);
              window.fbq("track", "PageView");
            }
            if (linkedin) {
              window._linkedin_partner_id = linkedin;
              window._linkedin_data_partner_ids = [linkedin];
              addScript("https://snap.licdn.com/li.lms-analytics/insight.min.js");
            }
            if (tiktokPixel) {
              // TikTok's queue stub: calls made before events.js loads are replayed by it.
              var ttq = (window.ttq = window.ttq || []);
              ttq.methods = ["page", "track", "identify", "instances", "debug", "on", "off", "once", "ready", "alias", "group", "enableCookie", "disableCookie"];
              ttq.setAndDefer = function (t, e) {
                t[e] = function () { t.push([e].concat(Array.prototype.slice.call(arguments, 0))); };
              };
              for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
              var ttSrc = "https://analytics.tiktok.com/i18n/pixel/events.js";
              ttq._i = ttq._i || {};
              ttq._i[tiktokPixel] = [];
              ttq._i[tiktokPixel]._u = ttSrc;
              ttq._t = ttq._t || {};
              ttq._t[tiktokPixel] = +new Date();
              ttq._o = ttq._o || {};
              ttq._o[tiktokPixel] = {};
              addScript(ttSrc + "?sdkid=" + encodeURIComponent(tiktokPixel) + "&lib=ttq");
              ttq.page();
            }
          }
          var banner = document.getElementById("consent-banner");
          var choice = null;
          try { choice = localStorage.getItem("tk_consent"); } catch (e) {}
          if (choice === "granted") loadPixels();
          else if (choice !== "denied" && banner) banner.hidden = false;
          function decide(value) {
            try { localStorage.setItem("tk_consent", value); } catch (e) {}
            if (banner) banner.hidden = true;
            if (value === "granted") loadPixels();
          }
          document.getElementById("consent-accept").addEventListener("click", function () { decide("granted"); });
          document.getElementById("consent-reject").addEventListener("click", function () { decide("denied"); });
        </script>
      )
    }
  </body>
</html>
