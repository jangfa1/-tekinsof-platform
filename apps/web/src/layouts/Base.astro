---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;

// PUBLIC_* values are read at build time; the site is fully static.
const whatsappNumber = process.env.PUBLIC_WHATSAPP_NUMBER || "51981053022";
const bookingsUrl = process.env.PUBLIC_BOOKINGS_URL || "/#contacto";
const ga4 = process.env.PUBLIC_GA4_ID ?? "";
const metaPixel = process.env.PUBLIC_META_PIXEL_ID ?? "";
const linkedin = process.env.PUBLIC_LINKEDIN_PARTNER_ID ?? "";
const hasPixels = Boolean(ga4 || metaPixel || linkedin);

const whatsappText = `Hola Tekinsof, quiero información (${Astro.url.pathname})`;
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Tekinsof Consulting",
  url: "https://tekinsof.com",
  email: "info@tekinsof.com",
  telephone: "+51981053022",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. La Molina 145",
    addressLocality: "Ate",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
};
---

<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="min-h-dvh bg-background font-sans text-fg antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[var(--radius-control)] focus:bg-background focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="font-display text-xl font-bold tracking-tight">Tekinsof Consulting</a>
        <nav aria-label="Principal" class="flex flex-wrap items-center gap-6 text-sm font-medium">
          <a href="/#servicios" class="hover:text-link">Servicios</a>
          <a href="/#contacto" class="hover:text-link">Contacto</a>
          <a
            href={bookingsUrl}
            class="inline-flex min-h-9 items-center rounded-[var(--radius-control)] bg-accent px-4 py-2 text-accent-fg"
          >
            Agenda una reunión
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="mt-24 border-t border-border bg-surface">
      <div class="mx-auto grid max-w-[1200px] gap-6 px-4 py-12 text-sm md:grid-cols-3">
        <div>
          <p class="font-display text-lg font-bold">Tekinsof Consulting</p>
          <p class="mt-2 text-fg-muted">Tecnología y marketing digital para empresas en Perú.</p>
        </div>
        <address class="not-italic text-fg-muted">
          Av. La Molina 145, Ate, Lima<br />
          <a href="mailto:info@tekinsof.com" class="text-link">info@tekinsof.com</a><br />
          <a href="tel:+51981053022" class="text-link">+51 981 053 022</a>
        </address>
        <p><a href="/privacidad" class="text-link">Política de privacidad</a></p>
      </div>
    </footer>

    <a
      id="whatsapp-float"
      href={whatsappHref}
      aria-label="Escríbenos por WhatsApp"
      class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-success text-primary-fg shadow-[0_6px_20px_rgb(18_20_23/0.10)]"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-7 fill-current">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.2.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.4.1.1.1.7-.2 1.3Z"
        ></path>
      </svg>
    </a>
    <script is:inline>
      // Tag the WhatsApp text with the first-touch campaign stored by the lead form.
      try {
        var stored = JSON.parse(sessionStorage.getItem("tk_utm") || "null");
        var campaign = stored && stored.utm && stored.utm.campaign;
        var link = document.getElementById("whatsapp-float");
        if (campaign && link) {
          var url = new URL(link.href);
          url.searchParams.set("text", url.searchParams.get("text") + " [" + campaign + "]");
          link.href = url.toString();
        }
      } catch (e) {}
    </script>

    {
      hasPixels && (
        <div
          id="consent-banner"
          hidden
          role="region"
          aria-label="Consentimiento de cookies"
          class="fixed inset-x-4 bottom-20 z-50 mx-auto max-w-xl rounded-[var(--radius-card)] border border-border bg-background p-4 shadow-[0_10px_30px_rgb(18_20_23/0.18)]"
        >
          <p class="text-sm">
            Usamos cookies de medición para mejorar nuestros anuncios. ¿Nos permites usarlas?{" "}
            <a href="/privacidad" class="text-link">Más información</a>
          </p>
          <div class="mt-3 flex gap-2">
            <button
              type="button"
              id="consent-accept"
              class="min-h-9 rounded-[var(--radius-control)] bg-accent px-4 text-sm font-medium text-accent-fg"
            >
              Aceptar
            </button>
            <button
              type="button"
              id="consent-reject"
              class="min-h-9 rounded-[var(--radius-control)] border border-border px-4 text-sm font-medium"
            >
              Rechazar
            </button>
          </div>
        </div>
      )
    }
    {
      hasPixels && (
        <script is:inline define:vars={{ ga4, metaPixel, linkedin }}>
          function addScript(src) {
            var s = document.createElement("script");
            s.async = true;
            s.src = src;
            document.head.appendChild(s);
          }
          function loadPixels() {
            if (ga4) {
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", ga4);
              addScript("https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(ga4));
            }
            if (metaPixel) {
              var f = (window.fbq = function () {
                f.callMethod ? f.callMethod.apply(f, arguments) : f.queue.push(arguments);
              });
              f.push = f; f.loaded = true; f.version = "2.0"; f.queue = [];
              window._fbq = f;
              addScript("https://connect.facebook.net/en_US/fbevents.js");
              window.fbq("init", metaPixel);
              window.fbq("track", "PageView");
            }
            if (linkedin) {
              window._linkedin_partner_id = linkedin;
              window._linkedin_data_partner_ids = [linkedin];
              addScript("https://snap.licdn.com/li.lms-analytics/insight.min.js");
            }
          }
          var banner = document.getElementById("consent-banner");
          var choice = null;
          try { choice = localStorage.getItem("tk_consent"); } catch (e) {}
          if (choice === "granted") loadPixels();
          else if (choice !== "denied" && banner) banner.hidden = false;
          function decide(value) {
            try { localStorage.setItem("tk_consent", value); } catch (e) {}
            if (banner) banner.hidden = true;
            if (value === "granted") loadPixels();
          }
          document.getElementById("consent-accept").addEventListener("click", function () { decide("granted"); });
          document.getElementById("consent-reject").addEventListener("click", function () { decide("denied"); });
        </script>
      )
    }
  </body>
</html>
