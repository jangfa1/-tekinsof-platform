---
import type { Service } from "@tekinsof/core/catalog/services";
import { serviceIcon } from "../../lib/home-content.ts";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const columns = [
  { title: "Tecnología", items: services.filter((s) => s.category === "tecnologia") },
  { title: "Marketing digital", items: services.filter((s) => s.category === "marketing") },
].filter((c) => c.items.length > 0);
const links = [
  { href: "/#automatizacion", label: "Automatización e IA" },
  { href: "/#marketing", label: "Marketing" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-40 px-4 pt-3">
  <div class="theme-ink mx-auto flex max-w-[1200px] items-center justify-between gap-4 rounded-[var(--radius-card)] border border-border bg-background/75 py-2 pr-2 pl-4 backdrop-blur-xl">
    <a href="/" class="flex min-h-11 items-center gap-3 font-display text-lg font-bold tracking-tight">
      <span aria-hidden="true" class="flex gap-1">
        <span class="h-5 w-1.5 -skew-x-12 rounded-full bg-fg"></span>
        <span class="h-5 w-1.5 -skew-x-12 rounded-full bg-accent"></span>
        <span class="h-5 w-1.5 -skew-x-12 rounded-full bg-lilac"></span>
      </span>
      Tekinsof
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 text-sm font-medium lg:flex">
      <details data-menu class="group relative">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-[var(--radius-control)] px-3 hover:bg-surface [&::-webkit-details-marker]:hidden">
          Servicios
          <Icon name="chevron-down" class="size-4 transition-transform duration-180 group-open:rotate-180" />
        </summary>
        <div class="absolute top-full left-0 mt-3 grid w-176 grid-cols-2 gap-6 rounded-[var(--radius-card)] border border-border bg-background p-6 shadow-float">
          {
            columns.map((col) => (
              <div>
                <p class="eyebrow text-fg-muted">{col.title}</p>
                <ul class="mt-4 grid gap-1">
                  {col.items.map((s) => (
                    <li>
                      <a href={`/servicios/${s.slug}`} class="flex items-center gap-3 rounded-[var(--radius-control)] px-2 py-2 hover:bg-surface">
                        <Icon name={serviceIcon(s.slug, s.category)} class="size-4 text-lilac" />
                        {s.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>
      {
        links.map((l) => (
          <a href={l.href} class="inline-flex min-h-11 items-center rounded-[var(--radius-control)] px-3 hover:bg-surface">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <span class="hidden sm:block">
        <Button href="/#contacto" variant="light">Solicitar cotización</Button>
      </span>
      <details data-menu class="group lg:hidden">
        <summary aria-label="Abrir menú" class="inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-[var(--radius-control)] border border-border [&::-webkit-details-marker]:hidden">
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="x" class="hidden size-5 group-open:block" />
        </summary>
        <nav aria-label="Móvil" class="absolute inset-x-0 top-full mx-4 mt-2 max-h-[calc(100dvh-96px)] overflow-y-auto rounded-[var(--radius-card)] border border-border bg-background p-4 shadow-float">
          {
            columns.map((col) => (
              <div class="border-b border-border py-4 first:pt-0">
                <p class="eyebrow text-fg-muted">{col.title}</p>
                <ul class="mt-3 grid grid-cols-2 gap-1 text-sm">
                  {col.items.map((s) => (
                    <li>
                      <a href={`/servicios/${s.slug}`} class="flex min-h-11 items-center">{s.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <ul class="grid gap-1 py-4 font-medium">
            {links.map((l) => (
              <li>
                <a href={l.href} class="flex min-h-11 items-center">{l.label}</a>
              </li>
            ))}
          </ul>
          <Button href="/#contacto" variant="light" class="w-full">Solicitar cotización</Button>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline>
  // Close the <details> menus on outside click, on Escape and after following a link.
  (function () {
    var menus = document.querySelectorAll("details[data-menu]");
    function close(except) {
      menus.forEach(function (m) { if (m !== except) m.open = false; });
    }
    document.addEventListener("click", function (e) {
      var inside = e.target.closest && e.target.closest("details[data-menu]");
      close(inside);
      if (e.target.closest && e.target.closest("details[data-menu] a")) close(null);
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(null); });
  })();
</script>
