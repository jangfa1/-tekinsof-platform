---
import type { Service } from "@tekinsof/core/catalog/services";
import { company } from "../../lib/content.ts";
import Icon from "../ui/Icon.astro";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const featured = services.filter((s) => s.isFeatured);
const columns = [
  { title: "Tecnología", items: featured.filter((s) => s.category === "tecnologia").slice(0, 6) },
  {
    title: "Marketing digital",
    items: featured.filter((s) => s.category === "marketing").slice(0, 6),
  },
];
const year = new Date().getFullYear();
---

<footer class="theme-ink relative overflow-hidden pb-28 md:pb-0">
  <div class="mx-auto grid max-w-[1200px] gap-12 px-4 pt-20 pb-12 text-sm md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <p class="flex items-center gap-3 font-display text-xl font-bold">
        <span aria-hidden="true" class="flex gap-1">
          <span class="h-6 w-2 -skew-x-12 rounded-full bg-fg"></span>
          <span class="h-6 w-2 -skew-x-12 rounded-full bg-accent"></span>
          <span class="h-6 w-2 -skew-x-12 rounded-full bg-lilac"></span>
        </span>
        Tekinsof Consulting
      </p>
      <p class="mt-4 max-w-xs text-fg-muted">Tecnología y marketing digital para empresas en Perú.</p>
    </div>
    {
      columns.map((col) => (
        <div>
          <p class="eyebrow text-fg-muted">{col.title}</p>
          <ul class="mt-4 grid gap-1">
            {col.items.map((s) => (
              <li>
                <a href={`/servicios/${s.slug}`} class="inline-flex min-h-9 items-center hover:text-link">{s.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="eyebrow text-fg-muted">Contacto</p>
      <address class="mt-4 grid gap-3 not-italic text-fg-muted">
        <a href={company.mapsUrl} rel="noopener" target="_blank" class="flex gap-2 hover:text-fg">
          <Icon name="map-pin" class="mt-0.5 size-4 shrink-0" />
          {company.address}
        </a>
        <a href={`https://wa.me/${company.whatsapp}`} data-wa class="flex items-center gap-2 text-link">
          <Icon name="phone" class="size-4 shrink-0" />
          {company.phone}
        </a>
        <a href={`mailto:${company.email}`} class="flex items-center gap-2 text-link">
          <Icon name="mail" class="size-4 shrink-0" />
          {company.email}
        </a>
        <span class="flex gap-2">
          <Icon name="clock" class="mt-0.5 size-4 shrink-0" />
          {company.hours}
        </span>
      </address>
    </div>
  </div>
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 border-t border-border px-4 py-6 text-xs text-fg-muted">
    <p>© {year} Tekinsof Consulting</p>
    <a href="/privacidad" class="inline-flex min-h-9 items-center hover:text-link">Política de privacidad</a>
  </div>
</footer>
