---
import { funnel } from "../../lib/home-content.ts";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const widths = ["w-full", "w-11/12", "w-4/5", "w-2/3"];
const fills = ["bg-lilac/40", "bg-lilac/70", "bg-lilac", "bg-primary text-primary-fg"];
---

<section id="marketing" class="relative overflow-hidden py-24 md:py-32">
  <div aria-hidden="true" class="glow -top-24 -right-32 size-120 bg-lilac/60"></div>
  <div class="relative mx-auto max-w-[1200px] px-4">
    <SectionHeading
      index="04"
      eyebrow="Marketing digital"
      title="Campañas que llenan tu embudo y prospectos que no se pierden."
      lead="Diseñamos la marca, posicionamos tu sitio y lanzamos anuncios en Google, Facebook, Instagram y TikTok. Cada lead llega a WhatsApp Business y a tu equipo comercial con su origen registrado."
    />

    <div class="mt-16 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <ol class="reveal grid gap-3">
        {
          funnel.map((row, i) => (
            <li class:list={["mx-auto rounded-[var(--radius-card)] p-5 md:p-6", widths[i], fills[i]]}>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="font-display text-lg font-bold">
                  <span class="mr-3 font-mono text-xs">0{i + 1}</span>
                  {row.stage}
                </p>
                <ul class="flex flex-wrap gap-2">
                  {row.channels.map((channel) => (
                    <li class="rounded-full bg-background/80 px-3 py-1 text-xs font-medium text-fg">{channel}</li>
                  ))}
                </ul>
              </div>
              <p class="mt-2 text-sm">{row.text}</p>
            </li>
          ))
        }
      </ol>

      <div aria-hidden="true" class="relative mx-auto w-full max-w-md select-none">
        <div class="reveal-scale rounded-[var(--radius-card)] border border-border bg-background p-5 shadow-float">
          <p class="flex items-center gap-2 text-xs text-fg-muted">
            <span class="inline-flex size-6 items-center justify-center rounded-full bg-primary font-display text-xs font-bold text-primary-fg">T</span>
            Patrocinado · tekinsof.com
          </p>
          <div class="mt-4 aspect-[16/9] overflow-hidden rounded-[var(--radius-control)] bg-primary p-5">
            <div class="flex h-full flex-col justify-between">
              <div class="flex gap-2">
                <span class="h-16 w-3 -skew-x-12 rounded-full bg-surface/30"></span>
                <span class="h-16 w-3 -skew-x-12 rounded-full bg-lilac"></span>
                <span class="h-16 w-3 -skew-x-12 rounded-full bg-surface-accent/60"></span>
              </div>
              <p class="max-w-56 font-display text-lg font-bold text-primary-fg">Integra tu ERP con tu CRM</p>
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between gap-4">
            <p class="text-sm font-semibold">Tecnología para empresas en Perú</p>
            <span class="rounded-[var(--radius-control)] bg-surface px-3 py-2 text-xs font-semibold">Más información</span>
          </div>
        </div>

        <div class="float-late absolute -bottom-28 -left-4 w-64 rounded-[var(--radius-card)] border border-border bg-background p-4 shadow-float sm:-left-24">
          <p class="flex items-center gap-2 text-xs font-semibold">
            <span class="inline-flex size-6 items-center justify-center rounded-full bg-success text-primary-fg">
              <Icon name="message-circle" class="size-3" />
            </span>
            WhatsApp Business
          </p>
          <p class="mt-3 ml-auto w-fit max-w-48 rounded-[var(--radius-control)] bg-success/10 px-3 py-2 text-xs">Vi su anuncio, quiero una cotización.</p>
          <p class="mt-2 w-fit max-w-48 rounded-[var(--radius-control)] bg-surface px-3 py-2 text-xs">¡Hola! Un especialista te escribe en minutos.</p>
          <p class="mt-3 flex items-center gap-1 font-mono text-xs text-success">
            <Icon name="check" class="size-3" /> Lead registrado en el CRM
          </p>
        </div>
      </div>
    </div>

    <div class="reveal mt-32 flex flex-wrap items-center gap-4">
      <Button href="#contacto" icon="arrow-right">Quiero más prospectos</Button>
      <p class="text-sm text-fg-muted">Branding · SEO · Google Ads · Facebook Ads · Instagram Ads · TikTok Ads</p>
    </div>
  </div>
</section>
