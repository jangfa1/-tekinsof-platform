---
// Testimonial (08) and client logos (09); content and authorisation notes in lib/home-cases.ts.
import { clientLogos, testimonial } from "../../lib/home-cases.ts";
import Eyebrow from "../ui/Eyebrow.astro";

const initials = testimonial.name
  .split(" ")
  .map((word) => word[0])
  .join("");
---

<section id="testimonios" class="relative overflow-hidden bg-surface-accent py-24 md:py-32">
  <div aria-hidden="true" class="bg-dots-light pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto grid max-w-[1200px] gap-12 px-4 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
    <div class="reveal flex flex-col">
      <Eyebrow index="08" indexClass="text-fg" class="text-fg-muted">Testimonios</Eyebrow>
      <p class="mt-8 text-balance font-display text-3xl leading-tight font-bold tracking-tight md:text-5xl">
        <span aria-hidden="true" class="block font-display text-7xl leading-none text-fg/25">“</span>
        {testimonial.highlight}
      </p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          testimonial.tags.map((tag) => (
            <li class="rounded-full border border-fg/10 bg-background px-3 py-1 text-xs font-medium">{tag}</li>
          ))
        }
      </ul>
    </div>

    <figure class="reveal-scale rounded-[var(--radius-card)] border border-fg/10 bg-background p-6 shadow-dialog md:p-10">
      <img
        src={testimonial.logo.src}
        alt={`Logo de ${testimonial.company}`}
        width={testimonial.logo.width}
        height={testimonial.logo.height}
        loading="lazy"
        decoding="async"
        class="h-14 w-auto rounded-[var(--radius-control)]"
      />
      <blockquote class="mt-8 grid gap-4 text-fg-muted md:text-lg">
        {testimonial.paragraphs.map((p) => <p>{p}</p>)}
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4 border-t border-border pt-6">
        <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-fg font-display font-bold text-background">
          {initials}
        </span>
        <span>
          <span class="block font-semibold">{testimonial.name}</span>
          <span class="block text-sm text-fg-muted">{testimonial.role} · {testimonial.company}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<section id="clientes" class="py-20 md:py-24">
  <div class="mx-auto max-w-[1200px] px-4">
    <div class="reveal flex flex-col items-center gap-4 text-center">
      <Eyebrow index="09">Clientes</Eyebrow>
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">Empresas que confían en Tekinsof</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        clientLogos.map((logo, i) => (
          <li
            class:list={[
              "reveal card-premium flex h-28 items-center justify-center rounded-[var(--radius-card)] border border-border bg-background px-6",
              i % 3 === 1 && "reveal-2",
              i % 3 === 2 && "reveal-3",
            ]}
          >
            <img
              src={logo.src}
              alt={logo.name}
              width={logo.width}
              height={logo.height}
              loading="lazy"
              decoding="async"
              class="max-h-14 w-auto max-w-full object-contain"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
