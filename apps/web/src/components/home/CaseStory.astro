---
// One client story: logo and context, a three-beat transformation timeline, results, and the
// illustrated solution with its headline metric. `reverse` alternates the columns on desktop.
import type { CaseStudy } from "../../lib/home-cases.ts";
import Icon from "../ui/Icon.astro";
import CaseVisual from "./CaseVisual.astro";

interface Props {
  item: CaseStudy;
  reverse?: boolean;
  serviceHref?: string;
}

const { item, reverse = false, serviceHref } = Astro.props;
const headingId = `caso-${item.id}-titulo`;
---

<article
  aria-labelledby={headingId}
  class="reveal grid grid-cols-1 gap-10 rounded-[var(--radius-card)] border border-border bg-background p-6 md:p-10 lg:grid-cols-2 lg:gap-14"
>
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex h-14 items-center rounded-[var(--radius-control)] border border-border bg-background px-4">
        <img
          src={item.logo.src}
          alt={`Logo de ${item.company}`}
          width={item.logo.width}
          height={item.logo.height}
          loading="lazy"
          decoding="async"
          class="h-9 w-auto max-w-40 object-contain"
        />
      </span>
      <span class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-fg-muted">{item.sector}</span>
    </div>

    <p class="eyebrow mt-8 flex items-center gap-2 text-fg-muted">
      <Icon name={item.icon} class="size-4" />
      {item.company}
    </p>
    <h3 id={headingId} class="mt-3 font-display text-2xl font-bold tracking-tight md:text-3xl">
      {item.title}
    </h3>

    <ol class="relative mt-8 grid gap-6">
      <li aria-hidden="true" class="absolute top-2 bottom-2 left-5 w-px bg-border">
        <span class="track-fill-y block size-full bg-linear-to-b from-fg to-lilac"></span>
      </li>
      {
        item.story.map((beat) => (
          <li class="relative flex gap-4">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-background shadow-[0_0_0_6px_var(--background)]">
              <Icon name={beat.icon} class="size-4" />
            </span>
            <span>
              <span class="eyebrow block text-link">{beat.stage}</span>
              <span class="mt-1 block text-sm text-fg-muted md:text-base">{beat.text}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class:list={["flex flex-col gap-6", reverse && "lg:order-first"]}>
    <div class="group relative">
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface shadow-float transition-transform duration-240 group-hover:-translate-y-1 motion-reduce:transition-none">
        <CaseVisual kind={item.visual} />
      </div>
      <div class="reveal-scale relative mx-4 -mt-8 rounded-[var(--radius-card)] border border-border bg-background p-5 shadow-dialog sm:mx-8">
        <p class="font-display text-5xl font-bold tracking-tight tabular-nums md:text-6xl">
          <span data-count={item.metric.value}>{item.metric.value}</span>{item.metric.suffix}
        </p>
        <p class="mt-1 text-sm font-medium">{item.metric.label}</p>
      </div>
    </div>

    <div>
      <p class="eyebrow text-fg-muted">Resultados</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          item.results.map((result) => (
            <li class="flex gap-2 text-sm">
              <Icon name="check" class="mt-0.5 size-4 shrink-0 text-success" />
              {result}
            </li>
          ))
        }
      </ul>
      {
        serviceHref && (
          <a href={serviceHref} class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold hover:text-link">
            Conoce el servicio <Icon name="arrow-right" class="size-4" />
          </a>
        )
      }
    </div>
  </div>
</article>
