---
import { automationPillars, integrationFlow } from "../../lib/home-content.ts";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  aiHref?: string;
}

const { aiHref } = Astro.props;

// Thin outlined diagrams for the three pillar cards (decorative).
const diagrams = [
  `<rect x="4" y="20" width="44" height="24" rx="6"/><rect x="88" y="20" width="44" height="24" rx="6"/><rect x="172" y="20" width="44" height="24" rx="6"/><path d="M48 32h40M132 32h40"/><path d="m82 27 6 5-6 5M166 27l6 5-6 5"/>`,
  `<rect x="4" y="12" width="64" height="40" rx="6"/><rect x="152" y="12" width="64" height="40" rx="6"/><path d="M68 26h84M68 38h84" stroke-dasharray="4 4"/><circle cx="110" cy="32" r="10"/>`,
  `<circle cx="20" cy="32" r="6"/><circle cx="80" cy="14" r="6"/><circle cx="80" cy="50" r="6"/><circle cx="140" cy="32" r="8"/><circle cx="200" cy="32" r="6"/><path d="M26 30l48-14M26 34l48 14M86 16l48 14M86 48l48-14M148 32h46"/>`,
];
---

<section id="automatizacion" class="theme-ink relative isolate overflow-hidden py-24 md:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-dots absolute inset-0"></div>
    <div class="glow drift top-1/3 left-1/2 size-160 -translate-x-1/2 bg-lilac/10"></div>
  </div>

  <div class="mx-auto max-w-[1200px] px-4">
    <SectionHeading
      index="03"
      eyebrow="Automatización e IA"
      title="Tus sistemas conectados, tus datos trabajando y la IA atendiendo por ti."
      lead="Unimos el ERP, el CRM, Power BI y WhatsApp en un solo flujo. Cada venta actualiza los tableros y cada consulta llega al vendedor correcto en minutos."
    />

    <div class="reveal-scale relative mt-16 rounded-[var(--radius-card)] border border-border bg-surface/50 p-4 backdrop-blur md:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <p class="eyebrow flex items-center gap-2 text-fg-muted">
          <span class="relative inline-flex size-2">
            <span class="ping absolute inline-flex size-full rounded-full bg-success"></span>
            <span class="relative inline-flex size-2 rounded-full bg-success"></span>
          </span>
          Flujo de integración
        </p>
        <p class="hidden font-mono text-xs text-fg-muted sm:block">ERP → CRM → Power BI → IA → WhatsApp</p>
      </div>

      <ol class="grid gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr_auto_1fr] lg:items-center lg:gap-0">
        {
          integrationFlow.map((node, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class="flex justify-center lg:block lg:w-12">
                  <span class="relative block h-6 w-px bg-border lg:h-px lg:w-full">
                    <span
                      class="packet absolute inset-y-0 left-0 hidden w-full lg:block"
                      style={`animation-delay: -${i * 0.8}s`}
                    >
                      <span class="absolute -top-1 left-0 size-2 rounded-full bg-lilac shadow-[0_0_12px_var(--lilac)]" />
                    </span>
                  </span>
                </li>
              )}
              <li
                class:list={[
                  "flex items-center gap-4 rounded-[var(--radius-card)] border bg-background p-4 lg:flex-col lg:items-start lg:gap-6 lg:p-5",
                  node.name === "IA" ? "border-lilac/50 shadow-[0_0_40px_rgb(231_219_231/0.15)]" : "border-border",
                ]}
              >
                <span
                  class:list={[
                    "inline-flex size-12 shrink-0 items-center justify-center rounded-[var(--radius-control)] border",
                    node.name === "IA" ? "border-lilac/50 bg-lilac text-primary-fg" : "border-border bg-surface text-lilac",
                  ]}
                >
                  <Icon name={node.icon} class="size-6" />
                </span>
                <span>
                  <span class="block font-display text-lg font-bold">{node.name}</span>
                  <span class="mt-1 block text-sm text-fg-muted">{node.role}</span>
                </span>
                <span aria-hidden="true" class="ml-auto font-mono text-xs whitespace-nowrap text-success lg:ml-0">● activo</span>
              </li>
            </>
          ))
        }
      </ol>
    </div>

    <ul class="mt-6 grid gap-6 md:grid-cols-3">
      {
        automationPillars.map((pillar, i) => (
          <li class:list={["reveal flex flex-col rounded-[var(--radius-card)] border border-border bg-surface p-6", i === 1 && "reveal-2", i === 2 && "reveal-3"]}>
            <span class="inline-flex size-11 items-center justify-center rounded-[var(--radius-control)] border border-border text-lilac">
              <Icon name={pillar.icon} class="size-5" />
            </span>
            <h3 class="mt-12 font-display text-xl font-semibold">{pillar.title}</h3>
            <p class="mt-2 text-sm text-fg-muted">{pillar.text}</p>
            <svg
              aria-hidden="true"
              viewBox="0 0 220 64"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              class="mt-10 w-full text-fg-muted"
              set:html={diagrams[i]}
            />
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-12 flex flex-wrap items-center gap-4">
      <Button href="#contacto" icon="arrow-right">Quiero automatizar mi empresa</Button>
      {
        aiHref && (
          <a href={aiHref} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-link hover:underline">
            Conoce IA para negocios <Icon name="arrow-right" class="size-4" />
          </a>
        )
      }
    </div>
  </div>
</section>
