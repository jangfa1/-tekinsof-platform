---
import { timeline } from "../../lib/home-content.ts";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="bg-surface py-24 md:py-32">
  <div class="mx-auto max-w-[1200px] px-4">
    <SectionHeading
      index="02"
      eyebrow="Transformación digital"
      title="De procesos manuales a una empresa conectada, en cinco etapas."
      lead="Avanzamos por etapas cortas con entregables visibles. Puedes empezar por la que más te urge."
    />

    <ol class="relative mt-16 grid gap-10 lg:mt-20 lg:grid-cols-5 lg:gap-6">
      <!-- The track fills with scroll: horizontal on desktop, vertical on mobile. -->
      <li aria-hidden="true" class="absolute top-0 bottom-0 left-6 w-px bg-border lg:top-6 lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto">
        <span class="track-fill block size-full bg-linear-to-b from-fg to-lilac lg:bg-linear-to-r"></span>
      </li>
      {
        timeline.map((stage, i) => (
          <li class:list={["reveal relative pl-20 lg:pl-0", i % 3 === 1 && "reveal-2", i % 3 === 2 && "reveal-3"]}>
            <span class="absolute top-0 left-0 inline-flex size-12 items-center justify-center rounded-full border border-border bg-background text-fg shadow-[0_0_0_8px_var(--surface)] lg:relative">
              <Icon name={stage.icon} class="size-5" />
            </span>
            <p class="eyebrow text-link lg:mt-8">Etapa {stage.step}</p>
            <h3 class="mt-3 font-display text-xl font-semibold">{stage.title}</h3>
            <p class="mt-2 text-sm text-fg-muted">{stage.text}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {stage.tags.map((tag) => (
                <li class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium">
                  {tag}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16 flex flex-col items-start justify-between gap-6 border-t border-border pt-8 md:flex-row md:items-center">
      <p class="max-w-xl text-lg">
        ¿No sabes por dónde empezar? Te ayudamos a identificar la etapa que más impacto tendrá en tu
        negocio.
      </p>
      <Button href="#contacto" icon="arrow-right">Agenda un diagnóstico</Button>
    </div>
  </div>
</section>
