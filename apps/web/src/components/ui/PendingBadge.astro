---
// Marks temporary content (lib/home-placeholders.ts) until real, verified data replaces it.
interface Props {
  label?: string;
}

const { label = "Contenido de ejemplo · pendiente" } = Astro.props;
---

<span
  class="eyebrow inline-flex items-center gap-2 rounded-full border border-dashed border-warning/60 bg-background px-3 py-2 text-warning"
>
  <span aria-hidden="true" class="size-2 rounded-full bg-warning"></span>
  {label}
</span>
