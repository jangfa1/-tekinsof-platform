{
  "name": "tekinsof-plataforma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @tekinsof/crm run test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @tekinsof/core run db:generate",
    "db:migrate": "pnpm --filter @tekinsof/core run db:migrate",
    "db:seed": "pnpm --filter @tekinsof/core run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
